# Cloudflare Pages response headers (same as vercel.json). Keep the two in sync while Vercel
# stays as a backup. CSP is enforced: see "Keamanan" in CLAUDE.md before adding a host.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://cmrdapfuqtjlmpepfwfq.supabase.co https://api.sandbox.midtrans.com https://api.midtrans.com; connect-src 'self' https://cmrdapfuqtjlmpepfwfq.supabase.co https://api.sandbox.midtrans.com https://api.midtrans.com; frame-src https://www.openstreetmap.org https://www.google.com https://maps.google.com; form-action 'self'; frame-ancestors 'none'

# The *.pages.dev address duplicates the site: keep it out of search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
